DEBUG=false
DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Render dashboard may also use SECRET_KEY.
# SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=your-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
PUBLIC_BASE_URL=https://your-service.onrender.com
WHATSAPP_ENABLED=false

# Optional: set DATABASE_URL to a Render PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Or use the individual variables shown in Render:
# DB_HOST=postgres-host
# DB_NAME=database-name
# DB_USER=database-user
# DB_PASSWORD=database-password
# DB_PORT=5432
# META_WHATSAPP_TOKEN=replace-in-render-dashboard
# META_PHONE_NUMBER_ID=replace-in-render-dashboard
# WHATSAPP_TEMPLATE_LANGUAGE=ar
# WHATSAPP_WELCOME_TEMPLATE=welcome_ar
# WHATSAPP_EXAM_TEMPLATE=exam_ar
